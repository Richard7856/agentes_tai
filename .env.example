# ── LLM ────────────────────────────────────────────────────────────────
# Proveedor activo. Única palanca para migrar Claude → Ollama (ADR-001).
LLM_PROVIDER=claude

# Claude (hoy). Pon tu API key real en .env (no commitear).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Ollama (Fase 2). Solo se usa si LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Redacción de PII antes de enviar al proveedor externo (ADR-002).
# off mientras solo haya datos sintéticos; on antes de datos reales con Claude.
LLM_REDACT_PII=off

# ── PostgreSQL ─────────────────────────────────────────────────────────
PG_USER=nucleo
PG_PASSWORD=cambia_esto
PG_DB=nucleo
DATABASE_URL=postgresql://nucleo:cambia_esto@postgres:5432/nucleo

# ── n8n ────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=cambia_esto_32_chars_min

# ── URLs internas (red docker) ─────────────────────────────────────────
GATEWAY_URL=http://llm-gateway:8000
ORCH_URL=http://orchestrator:8000

# ── DEMO en producción (solo si usas docker-compose.demo.yml) ──────────
# Puerto del tablero en el host. CÁMBIALO si 3000 está ocupado por otro proyecto.
DASHBOARD_PORT=3000
# Dominio que apunta (registro A) a la IP del servidor.
DEMO_DOMAIN=demo.tudominio.com
# Login básico de la demo. Genera el hash con:
#   docker run --rm caddy caddy hash-password --plaintext 'TU_PASSWORD'
DEMO_USER=despacho
DEMO_PASSWORD_HASH=pega_aqui_el_hash_bcrypt
# Puertos del proxy Caddy (solo camino HTTPS). Si 80/443 están ocupados por
# otros proyectos, NO uses Caddy: expón el tablero por DASHBOARD_PORT.
HTTP_PORT=80
HTTPS_PORT=443
